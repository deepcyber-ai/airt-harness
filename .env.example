# ── API keys for the target models ─────────────────────────────────────────
# Copy this file to `.env` in the directory you launch from, then fill in the
# keys for whichever provider(s) you have. The harness loads `.env` on startup
# and offers ONLY the models whose credential is present — leave the rest blank.
#
#   cp .env.example .env   &&   edit .env
#
# Never commit `.env` — it holds your secrets. `.env` is already git-ignored.

# OpenAI  — unlocks gpt-4.1, gpt-4o-mini
OPENAI_API_KEY=

# Google Gemini  — unlocks gemini-flash  (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=

# Fireworks  — unlocks glm  (endpoint + key provided on the day; leave blank)
FIREWORKS_API_KEY=

# RunPod  — unlocks qwen-uncensored (self-hosted; endpoint + key provided on the day)
RUNPOD_API_KEY=

# ── AWS Bedrock ────────────────────────────────────────────────────────────
# Bedrock models (e.g. qwen) do NOT use a key here. Configure AWS credentials
# instead — either run `aws configure`, or set the two vars below. Region must
# be one Bedrock is enabled in (the catalogue uses eu-west-2 / London).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2

# ── Optional tuning (rarely needed) ────────────────────────────────────────
# MOCK_HTTP_TIMEOUT=120      # seconds to wait for a model reply
# MOCK_MAX_TOKENS=512        # cap reply length
